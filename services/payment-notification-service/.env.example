PORT=5006
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/payment_notification_db
JWT_SECRET=your_jwt_secret_same_as_auth_service
APPOINTMENT_SERVICE_URL=http://localhost:5004

# PayHere (sandbox)
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_MODE=sandbox

# Email (Nodemailer via Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=MediConnect <your_email@gmail.com>

NODE_ENV=development
